DISCORD_TOKEN=
CLIENT_ID=

# MySQL/MariaDB containing the FiveM duty_hours table.
# The bot still starts and acknowledges Discord interactions if MySQL is offline.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=CHANGE_ME

TIMEZONE=Europe/London
DUTY_POLL_MS=5000
DB_TIMEOUT_MS=1500
DB_RETRY_COOLDOWN_MS=15000

# Optional Discord user IDs that always count as bot administrators.
# Separate multiple IDs with commas.
BOT_ADMINS=
